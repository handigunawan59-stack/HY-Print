{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "hy-print",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "SETTINGS",
      "id": "2c3a6c440ee8434a8a9208cf457825c1"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "90829173",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "hy-print-admin",
      "database_id": "6f77b288-101d-4ceb-9f3f-7f0d2a126e97",
      "migrations_dir": "migrations"
    }
  ]
}
